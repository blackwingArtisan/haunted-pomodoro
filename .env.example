# Which store keeps the house. "local" (default) keeps everything in this browser's localStorage.
# "cloudflare" also syncs a copy to the Cloudflare Worker in worker/ (KV-backed). Not used in tests.
VITE_HOUSE_STORE=local

# Only read when VITE_HOUSE_STORE=cloudflare.
VITE_SYNC_URL=https://haunted-pomodoro-sync.example.workers.dev
